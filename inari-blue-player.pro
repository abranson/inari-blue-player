QT = core dbus
CONFIG += console c++11
CONFIG -= app_bundle
TEMPLATE = app
TARGET = inari-blue-player
SOURCES = src/main.cpp src/pattern.cpp src/player.cpp src/hardware.cpp
HEADERS = src/pattern.h src/player.h src/hardware.h src/businterfaces.h
QMAKE_CXXFLAGS += -Wall -Wextra
unix: LIBS += -lrt
target.path = /usr/libexec
patterns.path = /usr/share/inari-blue/patterns
patterns.files = patterns/*.json
service.path = /usr/lib/systemd/user
service.files = data/inari-blue-player.service
dbusservice.path = /usr/share/dbus-1/services
dbusservice.files = data/org.sailfishos.InariBlue1.service
toh.path = /usr/share/tohd-1/tohs/0001/0004
toh.files = data/inari-player.yaml
INSTALLS += target patterns service dbusservice toh
